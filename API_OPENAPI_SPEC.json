                }
              }
            }
          }
        }
      }
    },
    "/api/weather/grid/{lat}/{lon}": {
      "get": {
        "tags": [
          "Meteorology & Nowcasting"
        ],
        "summary": "Get Grid Cell",
        "description": "Return full 20-feature GridCellSchema for clicked 1 km \u00d7 1 km cell.\n\nPowered by live government feeds (MOSDAC/IMD) with historical fallback.",
        "operationId": "get_grid_cell_api_weather_grid__lat___lon__get",
