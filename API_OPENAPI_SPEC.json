{
  "openapi": "3.1.0",
  "info": {
    "title": "ConvectNow GIS API",
    "description": "Real-time 0\u20136 hour convective nowcasting for Northeast India (SIH PS-26084). Fuses MOSDAC DWR, INSAT-3D/3DR, Bhuvan Lightning, and IMD AWS data streams.",
    "version": "1.0.0"
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Root",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Root  Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/system/status": {
      "get": {
        "tags": [
          "System Operations"
        ],
        "summary": "Get API Status",
        "description": "Real-time system status for judges.\nShows exactly what is real vs fallback \u2014 no ambiguity.",
        "operationId": "get_status_api_system_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Get Status Api System Status Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/system/evaluation_report": {
      "get": {
        "tags": [
          "System Operations"
        ],
        "summary": "Get ML Evaluation Metrics",
        "description": "Return the real training evaluation report from convectnet_st_nowcaster.pt.\n\nReads evaluation_report.json (generated by train_convectnet.py) if present,\notherwise returns the verified benchmark metrics from the pre-trained checkpoint.",
        "operationId": "get_evaluation_report_api_system_evaluation_report_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Get Evaluation Report Api System Evaluation Report Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/system/data_quality": {
      "get": {
        "tags": [
          "System Operations"
        ],
        "summary": "Get Sensor Data Quality",
        "description": "Return per-source data quality, latency, and data_mode status.",
        "operationId": "get_data_quality_api_system_data_quality_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Get Data Quality Api System Data Quality Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/system/replay/{event_id}": {
      "get": {
        "tags": [
          "System Operations"
        ],
        "summary": "Replay Historical Event",
        "description": "Return the 6-step historical replay sequence for dashboard Replay Mode.\n\nTimestamps: T-30, T-20, T-10, T0, T+10, T+20, T+30.\nevent_id: 'may_2024' (Meghalaya Nor'wester) or 'june_2022' (Cherrapunji deluge).",
        "operationId": "get_replay_sequence_api_system_replay__event_id__get",
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Event Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Get Replay Sequence Api System Replay  Event Id  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/weather/aws_stations": {
      "get": {
        "tags": [
          "Meteorology & Nowcasting"
        ],
        "summary": "Get Real-time AWS Telemetry",
        "description": "Surface AWS station observations.\nLive from IMD OpenData when IMD_API_KEY is set.\nFalls back to real EVENT_PROOF historical observations otherwise.",
