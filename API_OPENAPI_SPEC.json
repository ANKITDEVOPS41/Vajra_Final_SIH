    "/api/weather/storm/cells": {
      "get": {
        "tags": [
          "Meteorology & Nowcasting"
        ],
        "summary": "Get Active Storm Cells",
        "description": "Return active storm cells as GeoJSON FeatureCollection.\n\nCells detected by Stage 1 (threshold + segmentation) over Northeast India,\nenriched with authentic meteorological hazard derivations (Rain, Hail, Lightning, Shear).",
        "operationId": "get_storm_cells_api_weather_storm_cells_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Get Storm Cells Api Weather Storm Cells Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/weather/forecast/{lead_time_min}": {
      "get": {
        "tags": [
          "Meteorology & Nowcasting"
        ],
        "summary": "Get Forecast",
        "description": "Return ConvectNet ForecastOutputSchema for the given lead time (minutes).\n\nValid lead times: 0, 10, 15, 20, 30, 45, 60, 120, 180, 240, 300, 360.\nNearest valid lead time is selected if an intermediate value is requested.",
        "operationId": "get_forecast_api_weather_forecast__lead_time_min__get",
        "parameters": [
          {
            "name": "lead_time_min",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Lead Time Min"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForecastOutputSchema"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/weather/hazards": {
      "get": {
        "tags": [
          "Meteorology & Nowcasting"
        ],
        "summary": "Get Hazard Risk Grid",
        "description": "Return all 5 convective hazard probability fields as GeoJSON.\n\nSpatial grid at 1 km resolution over Northeast India domain.\nUses ConvectNet Stage 5 probabilities from historical_fallback or live data.",
        "operationId": "get_hazards_api_weather_hazards_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Get Hazards Api Weather Hazards Get"
                }
              }
            }
          }
        }
      }
    },
    "/ws/live/info": {
      "get": {
        "tags": [
          "WebSockets"
        ],
        "summary": "WebSocket Connection Info",
        "description": "### \ud83d\udd0c Live Telemetry WebSocket\n**Note**: Swagger UI does not natively support testing WebSockets.\n\nTo connect to the live hazard stream, use a WebSocket client (like Postman or a browser) and connect to:\n\n`ws://localhost:8008/ws/live`\n\n**Payload (JSON)**:\n- `timestamp`: ISO-8601 string\n- `update_type`: \"periodic\" or \"instant\"\n- `grid_nowcast`: Real-time 3x3 hazard matrix\n- `storm_cells`: Active tracked convective cells",
        "operationId": "websocket_info_ws_live_info_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
